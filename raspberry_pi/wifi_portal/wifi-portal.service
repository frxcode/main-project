[Unit]
Description=Verifier Wi-Fi setup captive portal
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
# oneshot: залежні сервіси (main.py) стартують лише ПІСЛЯ того,
# як портал завершиться (мережа налаштована або вже була)
Type=oneshot
TimeoutStartSec=infinity
ExecStart=/usr/bin/python3 /opt/wifi-portal/wifi_portal.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
